title Communication Diagram: Laporan Arus Kas dan Ekspor Laporan PDF/Excel (KF-11, KF-14)

actor "Bendahara" as Bend
actor "Admin/Pengurus" as Admin
rectangle "<u>:LaporanArusKas</u>" as L
rectangle "<u>:TransaksiPembayaran</u>" as Trx
rectangle "<u>:TagihanIuran</u>" as Tag
rectangle "<u>:EksporLaporan</u>" as E
rectangle "<u>:RekapKehadiran</u>" as Rk

Bend --> L : 1: buatLaporanBulanan(bulan, tahun)
L --> Trx : 1.1: ambil total pemasukan\ndan jumlah transaksi
L --> Tag : 1.2: ambil total tunggakan
L ..> Bend : 1.3: laporan arus kas bulanan
Bend --> L : 2: buatLaporanTahunan(tahun)
L --> Trx : 2.1: ambil total pemasukan\ndan jumlah transaksi
L --> Tag : 2.2: ambil total tunggakan
L ..> Bend : 2.3: laporan arus kas tahunan
Bend --> E : 3: eksporPDF()
E --> L : 3.1: ambil data laporan keuangan
E ..> Bend : 3.2: berkas laporan keuangan PDF
Bend --> E : 4: eksporExcel()
E --> L : 4.1: ambil data laporan keuangan
E ..> Bend : 4.2: berkas laporan keuangan Excel
Admin --> E : 5: eksporPDF()
E --> Rk : 5.1: lihatRekapPerPeriode(awal, akhir)
E ..> Admin : 5.2: berkas rekap presensi PDF
Admin --> E : 6: eksporExcel()
E --> Rk : 6.1: lihatRekapPerPeriode(awal, akhir)
E ..> Admin : 6.2: berkas rekap presensi Excel

@enduml
