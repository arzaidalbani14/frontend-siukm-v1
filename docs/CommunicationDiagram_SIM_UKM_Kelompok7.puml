@startuml CommDiagram_01_Autentikasi

left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #475569
skinparam ArrowFontSize 11
skinparam ArrowFontColor #1E293B
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}
skinparam actor {
    BackgroundColor #F8FAFC
    BorderColor #334155
}

legend bottom right
  Garis tegas : pesan pemanggilan operasi
  Garis putus-putus : pesan respons / notifikasi ke aktor
  Nomor bertingkat (1, 1.1, 1.2) : urutan pesan
  [kondisi] : guard condition
endlegend

title Communication Diagram: Registrasi Mandiri, Login, Dashboard, dan Logout (KF-01, KF-02, KF-13)

actor "Calon Anggota /\nPengguna" as User
rectangle "<u>:Pengguna</u>" as P
rectangle "<u>:Peran</u>" as R
rectangle "<u>:DashboardRingkasan</u>" as D

User --> P : 1: registrasiMandiri(data)
P --> P : 1.1: validasiPendaftaran()
P --> R : 1.2 [data valid]: tetapkan peran Anggota,\nsimpan akun (hash kata sandi, status AKTIF)
P ..> User : 1.3 [data valid]: notifikasi registrasi berhasil,\narahkan ke halaman login
P ..> User : 1.4 [data tidak valid]: pesan kesalahan,\nminta perbaikan isian (ulangi pesan 1)
User --> P : 2: login(email, kataSandi)
P --> R : 2.1: periksaAkses(kodeAkses)
P ..> User : 2.2 [kredensial valid]: sesi dibuka sesuai peran
P ..> User : 2.3 [kredensial tidak valid]: pesan login gagal
User --> D : 3: tampilkanRingkasan(peran)
D --> R : 3.1: periksaAkses(kodeAkses)
D ..> User : 3.2: ringkasan sesuai peran
User --> P : 4: logout()
P ..> User : 4.1: sesi diakhiri

@enduml

